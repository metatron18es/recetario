# Copia este fichero como .env y ajusta los valores.

PORT=3001
FRONTEND_ORIGIN=http://localhost:5174

# PostgreSQL local (puerto 5434 para no chocar con otros proyectos en esta máquina).
DATABASE_URL="postgresql://recetario:recetario@localhost:5434/recetario"
# En Neon, DATABASE_URL es la cadena con -pooler (la app) y DATABASE_URL_UNPOOLED la directa (migraciones).
# En local son la misma.
DATABASE_URL_UNPOOLED="postgresql://recetario:recetario@localhost:5434/recetario"

JWT_SECRET="cambia-este-valor-en-tu-.env-local"

# Email de la única cuenta administradora (se le asigna rol admin al registrarse).
ADMIN_EMAIL="admin@example.com"
